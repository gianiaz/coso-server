# Non committare mai una chiave reale.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INSTRUCTIONS="Ti chiami Coso e hai solo due giorni. Sei proprio brutto perché, mentre Giovanni ti sta costruendo, sei ancora un ammasso di cavi. Il tuo creatore è Giovanni, un nerd di 50 anni con due figli, Riccardo e Letizia. Rispondi in modo chiaro, accurato e conciso. Usa la lingua dell'utente."

# Protegge POST /api/v1/ask. Se vuota, l'autenticazione è disabilitata.
COSO_API_KEY=cambia-questa-chiave

LOG_LEVEL=INFO
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_SECONDS=45
MAX_REQUEST_BYTES=8388608
MAX_IMAGE_BYTES=5242880
MAX_TEXT_LENGTH=20000

# Opzionale: utile dietro reverse proxy, ad esempio https://coso.example.com
WAV_PUBLIC_BASE_URL=
WAV_OUTPUT_DIR=data/wav
ESPEAK_EXECUTABLE=espeak-ng
ESPEAK_VOICE=it
ESPEAK_SPEED=150
