[Unit]
Description=Coso Server GitHub deploy webhook
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/coso-server
EnvironmentFile=/etc/coso-deploy.env
Environment=PYTHONUNBUFFERED=1
Environment=GIT_SSH_COMMAND=/usr/bin/ssh -oBatchMode=yes
ExecStart=/home/pi/coso-deploy-venv/bin/gunicorn --bind 127.0.0.1:9000 --workers 1 --threads 2 --timeout 30 --access-logfile - --error-logfile - --log-level info scripts.deploy_webhook:create_app()
Restart=on-failure
RestartSec=5
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
